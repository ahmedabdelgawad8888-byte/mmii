# Operating agent — provider credentials
#
# Copy to .env.local and fill in whichever provider you use. Every one of these
# is optional: a visitor can instead paste their own key into Agent settings,
# where it is held in their browser and never written to the server.
#
# One key that routes to every provider (recommended).
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Direct providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Ollama Cloud, or a local `ollama serve` via OPENAI_COMPATIBLE_BASE_URL below.
OLLAMA_API_KEY=

# QwenCloud / Alibaba DashScope, OpenAI-compatible mode.
# QWEN_API_KEY is accepted as an alias.
DASHSCOPE_API_KEY=
# Override only for a different region, e.g. the mainland China endpoint.
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenCode Zen.
OPENCODE_ZEN_API_KEY=

# Any other OpenAI-compatible endpoint: Groq, Together, OpenRouter, DeepSeek,
# Fireworks, vLLM, LM Studio, or a private gateway.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

